# QuantumFintek local environment

APP_ENV=development

# API
API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://app.localhost,http://api.localhost,http://localhost

# JWT — RS256 with automated rotation
JWT_ALGORITHM=RS256
JWT_KEY_ID=qf-key-1
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREVIOUS_PUBLIC_KEYS_JSON=

# Persist key ring (recommended). Directory should be root-only / app-user only.
JWT_KEY_STORE_PATH=./secrets/jwt/keyring.json

# Automated rotation (background). Interval default 24h.
JWT_AUTO_ROTATE=false
JWT_ROTATION_INTERVAL_SECONDS=86400
JWT_MAX_PREVIOUS_KEYS=2
JWT_KEY_BITS=2048
JWT_KID_PREFIX=qf-key
# Non-prod: generate RSA if no PEM/store
JWT_AUTO_BOOTSTRAP=true

# PostgreSQL
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantum_fintek
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_MODE=standalone
REDIS_KEY_PREFIX=qf

# Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://api.localhost

# Production TLS
ACME_EMAIL=ops@example.com
APP_HOST=app.example.com
API_HOST=api.example.com
