# QuantumFintek local environment

APP_ENV=development

# API
API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Include every browser origin that will call the API
CORS_ORIGINS=http://localhost:3000,http://app.localhost,http://api.localhost,http://localhost

# PostgreSQL
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantum_fintek
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Traefik (optional overlay: docker-compose.traefik.yml)
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Frontend (when apps/web is enabled)
WEB_PORT=3000
# Host-based (recommended with Traefik): http://api.localhost
# Path-based: http://localhost/api
# Direct (no Traefik): http://localhost:8000
NEXT_PUBLIC_API_URL=http://api.localhost
