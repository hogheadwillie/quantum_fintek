# QuantumFintek local environment

APP_ENV=development

API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://app.localhost,http://api.localhost,http://localhost
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-Id

ENABLE_HSTS=false
AUTH_FAIL_CLOSED=true
WS_AUTH_RECHECK_SECONDS=30

JWT_ALGORITHM=RS256
JWT_KEY_ID=qf-key-1
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREVIOUS_PUBLIC_KEYS_JSON=
JWT_KEY_STORE_PATH=./secrets/jwt/keyring.json
JWT_AUTO_ROTATE=false
JWT_ROTATION_INTERVAL_SECONDS=86400
JWT_MAX_PREVIOUS_KEYS=2
JWT_KEY_BITS=2048
JWT_KID_PREFIX=qf-key
JWT_AUTO_BOOTSTRAP=true
JWT_JWKS_CACHE_MAX_AGE=300
JWT_JWKS_STALE_WHILE_REVALIDATE=60

POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantum_fintek
POSTGRES_PORT=5432

# Redis AUTH (compose default). Change in production.
REDIS_PASSWORD=quantum-redis-dev
REDIS_PORT=6379
REDIS_URL=redis://:quantum-redis-dev@localhost:6379/0
REDIS_MODE=standalone
REDIS_KEY_PREFIX=qf
# Production TLS to Redis:
# REDIS_SSL=true
# REDIS_SSL_CERT_REQS=required

TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://api.localhost

ACME_EMAIL=ops@example.com
APP_HOST=app.example.com
API_HOST=api.example.com
