# QuantumFintek local environment

APP_ENV=development

# API
API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://app.localhost,http://api.localhost,http://localhost

# JWT — RS256 with rotation (recommended)
# Generate: ./scripts/gen_jwt_rs256_keys.sh
JWT_ALGORITHM=RS256
JWT_KEY_ID=qf-key-1
# Paste PEMs with literal \n or use multiline in real secret managers
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# During rotation, keep the old public key until access+refresh TTLs expire:
# JWT_PREVIOUS_PUBLIC_KEYS_JSON={"qf-key-0":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
JWT_PREVIOUS_PUBLIC_KEYS_JSON=

# If JWT_PRIVATE_KEY_PEM is empty and APP_ENV=development, API falls back to HS256+SECRET_KEY.
# Production refuses HS* and requires JWT_PRIVATE_KEY_PEM.

# PostgreSQL
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantum_fintek
POSTGRES_PORT=5432

# Redis (standalone default)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_MODE=standalone
# Cluster:
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379
# REDIS_CLUSTER_NODE_TIMEOUT_MS=5000
# REDIS_SOCKET_CONNECT_TIMEOUT=2.0
# REDIS_SOCKET_TIMEOUT=5.0
# REDIS_CLUSTER_ERROR_RETRY_ATTEMPTS=5
REDIS_KEY_PREFIX=qf

# Traefik local overlay
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_RL_AVERAGE=50
TRAEFIK_RL_BURST=100
TRAEFIK_RL_LOGIN_AVERAGE=5
TRAEFIK_RL_LOGIN_BURST=10

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://api.localhost

# Production TLS
ACME_EMAIL=ops@example.com
APP_HOST=app.example.com
API_HOST=api.example.com
