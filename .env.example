# QuantumFintek local environment

APP_ENV=development

# API
API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://app.localhost,http://api.localhost,http://localhost

# PostgreSQL
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantum_fintek
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Traefik local overlay (docker-compose.traefik.yml)
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
# BasicAuth for http://traefik.localhost — generate with:
#   htpasswd -nbB admin 'your-password' | sed -e 's/\$/$$/g'
# Example (replace with your own hash):
# TRAEFIK_BASIC_AUTH=admin:$$2y$$05$$examplehash
TRAEFIK_RL_AVERAGE=50
TRAEFIK_RL_BURST=100
TRAEFIK_RL_LOGIN_AVERAGE=5
TRAEFIK_RL_LOGIN_BURST=10

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://api.localhost

# Production TLS overlay (docker-compose.traefik.tls.yml)
ACME_EMAIL=ops@example.com
APP_HOST=app.example.com
API_HOST=api.example.com
